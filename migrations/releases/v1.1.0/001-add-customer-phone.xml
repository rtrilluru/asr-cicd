<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ASR-001-add-phone-to-stg" author="developer">
        <addColumn tableName="STG_CUSTOMER" schemaName="ASR_OWNER">
            <column name="CUSTOMER_PHONE" type="VARCHAR2(20)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="STG_CUSTOMER" schemaName="ASR_OWNER" columnName="CUSTOMER_PHONE"/>
        </rollback>
    </changeSet>

    <changeSet id="ASR-001-add-phone-to-tgt" author="developer">
        <addColumn tableName="TGT_CUSTOMER" schemaName="ASR_OWNER">
            <column name="CUSTOMER_PHONE" type="VARCHAR2(20)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="TGT_CUSTOMER" schemaName="ASR_OWNER" columnName="CUSTOMER_PHONE"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
