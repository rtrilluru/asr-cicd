<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="add-customer-address" author="rtrilluru">
        <addColumn tableName="TGT_CUSTOMER">
            <column name="CUSTOMER_ADDRESS" type="VARCHAR2(500)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="TGT_CUSTOMER" columnName="CUSTOMER_ADDRESS"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
