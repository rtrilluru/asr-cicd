<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.5-001-add-customer-region" author="rtrilluru">
        <comment>Add REGION column to TGT_CUSTOMER for geographic tracking</comment>
        <addColumn tableName="TGT_CUSTOMER">
            <column name="REGION" type="VARCHAR2(50)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="TGT_CUSTOMER" columnName="REGION"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
