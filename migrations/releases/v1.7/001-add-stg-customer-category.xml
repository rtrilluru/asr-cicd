<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.7-001-add-stg-customer-category" author="rtrilluru">
        <comment>Add CUSTOMER_CATEGORY to staging table to accept category from source files</comment>
        <addColumn tableName="STG_CUSTOMER" schemaName="ASR_OWNER">
            <column name="CUSTOMER_CATEGORY" type="VARCHAR2(20)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="STG_CUSTOMER" schemaName="ASR_OWNER" columnName="CUSTOMER_CATEGORY"/>
        </rollback>
    </changeSet>

</databaseChangeLog>